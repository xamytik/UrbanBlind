# ============================================================
# UrbanBlind — .gitignore
# ============================================================

# === Python (Backend) ===
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/

# === Секреты — НИКОГДА не в репозиторий ===
.env
.env.local
.env.production
*.secret

# === Node.js / Next.js (Frontend) ===
node_modules/
frontend/.next/
.next/
out/
build/
.vercel/
*.tsbuildinfo
next-env.d.ts

# === Alembic ===
# Миграции коммитим! Только логи не нужны.

# === Базы данных ===
*.sqlite
*.db

# === Системные файлы ===
.DS_Store
Thumbs.db
desktop.ini

# === IDE ===
.vscode/settings.json
.idea/
*.swp
*.swo

# === Логи ===
*.log
logs/
npm-debug.log*
yarn-debug.log*
